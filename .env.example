# Copy to .env and replace every placeholder before running docker compose up.

# Postgres
POSTGRES_USER=getkeja
# URL-encode the password if it contains characters like @ : / or ?
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=getkeja

# Published ports on the host
SERVER_PORT=4000
CLIENT_PORT=3000

# Server
DB_POOL_MAX=20
LOG_LEVEL=info
# Set to true when the API sits behind a reverse proxy / load balancer
TRUST_PROXY=false

# Generate both with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-64-character-hex-secret
CSRF_SECRET=replace-with-a-64-character-hex-secret
