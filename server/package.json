{
  "name": "@get-keja/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.cli.ts",
    "migrate:create": "node --env-file=.env --import tsx src/db/migrate.cli.ts create",
    "migrate:status": "node --env-file=.env --import tsx src/db/migrate.cli.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "apn": "^2.2.0",
    "argon2": "^0.44.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.38.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  }
}
