# Copy to .env for local development.

NODE_ENV=development
PORT=4000

# PostgreSQL (shared by pg and pg-boss)
DATABASE_URL=postgres://getkeja:getkeja@localhost:5433/getkeja
DB_POOL_MAX=20

# Generate both with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-64-character-hex-secret
CSRF_SECRET=replace-with-a-64-character-hex-secret

# Logging
LOG_LEVEL=info

# Set to true only when running behind a reverse proxy
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis configuration
REDIS_URL=redis://localhost:6379

# Email configuration
# Provider: development (logs to console), sendgrid, mailgun, ses
EMAIL_PROVIDER=development
EMAIL_FROM_ADDRESS=noreply@getkeja.com
EMAIL_FROM_NAME=GetKeja
EMAIL_BASE_URL=http://localhost:3000

# Cloudinary profile photos and logos
# Create an account at cloudinary.com and copy these values into your ignored .env file.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Google Places API (New), server-side key restricted to Places API
# GOOGLE_MAPS_SERVER_API_KEY=your-server-side-places-key

# SendGrid (if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun (if EMAIL_PROVIDER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# AWS SES (if EMAIL_PROVIDER=ses)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Private S3 storage for profile verification documents (not public profile images)
# AWS_S3_PRIVATE_BUCKET=getkeja-private-documents

# SMS configuration
# Provider: development (logs to console), twilio, africastalking, vonage
SMS_PROVIDER=development
SMS_FROM_NUMBER=

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=your-twilio-phone-number

# Africa's Talking (if SMS_PROVIDER=africastalking)
# AFRICASTALKING_API_KEY=your-africastalking-api-key
# AFRICASTALKING_USERNAME=your-africastalking-username
# AFRICASTALKING_FROM_NUMBER=your-africastalking-shortcode

# Vonage/Nexmo (if SMS_PROVIDER=vonage)
# VONAGE_API_KEY=your-vonage-api-key
# VONAGE_API_SECRET=your-vonage-api-secret
# VONAGE_FROM_NUMBER=your-vonage-phone-number

# Google OAuth configuration
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_ALLOWED_CLIENT_IDS=comma,separated,client,ids (optional, for multiple clients)

# Verification settings
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PHONE_VERIFICATION_EXPIRY_MINUTES=10
PHONE_VERIFICATION_OTP_LENGTH=6
MAX_VERIFICATION_ATTEMPTS=5
LOGIN_OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Registration rate limiting
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX=5
OTP_REQUEST_RATE_LIMIT_WINDOW_MS=3600000
OTP_REQUEST_RATE_LIMIT_MAX=3

# Login rate limiting
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MS=900000
LOGIN_EMAIL_RATE_LIMIT_MAX=10
LOGIN_PHONE_RATE_LIMIT_WINDOW_MS=900000
LOGIN_PHONE_RATE_LIMIT_MAX=10
LOGIN_OTP_REQUEST_RATE_LIMIT_WINDOW_MS=900000
LOGIN_OTP_REQUEST_RATE_LIMIT_MAX=5
LOGIN_OTP_VERIFY_RATE_LIMIT_WINDOW_MS=900000
LOGIN_OTP_VERIFY_RATE_LIMIT_MAX=5
LOGIN_GOOGLE_RATE_LIMIT_WINDOW_MS=900000
LOGIN_GOOGLE_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=30

# MFA settings
MFA_CHALLENGE_EXPIRY_MINUTES=10
MFA_CHALLENGE_MAX_ATTEMPTS=3
MFA_EMAIL_RESEND_COOLDOWN_SECONDS=60
MFA_ENROLLMENT_TRANSACTION_MINUTES=15
