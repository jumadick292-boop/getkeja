NODE_ENV=development
PORT=3000

# PostgreSQL (shared by pg and pg-boss)
DATABASE_URL=postgres://getkeja:getkeja_dev@localhost:5432/getkeja_db
DB_POOL_MAX=20

# Security Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=replace_with_32_byte_random_hex_string_at_least_32_chars
CSRF_SECRET=replace_with_another_32_byte_random_hex_string_at_least_32_chars

# Logging
LOG_LEVEL=debug